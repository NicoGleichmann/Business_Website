---
import Base from '../layouts/Base.astro';
---

<Base titel="Seite nicht gefunden" noindex>
  <section class="container-page max-w-2xl py-20 text-center sm:py-28">
    <p class="eyebrow">Fehler 404</p>
    <h1 class="mt-3 text-4xl font-bold">Diese Seite gibt es nicht</h1>
    <p class="text-muted mt-4 text-lg">Vielleicht hat sich ein Tippfehler eingeschlichen, oder die Seite wurde verschoben.</p>
    <a href="/" class="btn btn-primary mt-8">Zur Startseite</a>
  </section>
</Base>
