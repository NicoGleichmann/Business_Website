---
/**
 * IMPRESSUM
 * Inhalt aus dem eRecht24-Impressum-Generator (erstellt für automatisierung.nicogleichmann.de).
 * Name, Anschrift und Kontaktdaten kommen aus src/config/site.ts – Änderungen bitte dort.
 * Bei geänderten Angaben (z. B. Kleinunternehmer, USt-IdNr.) das Impressum neu generieren
 * und die Textblöcke unten abgleichen.
 */
import Rechtliches from '../layouts/Rechtliches.astro';
import { site } from '../config/site';

const { inhaber, adresse, kontakt } = site;
const telefonLink = `tel:${kontakt.telefon.replace(/[^\d+]/g, '')}`;
---

<Rechtliches titel="Impressum" beschreibung={`Impressum von ${inhaber.name}, ${adresse.ort}.`}>
  <p>
    {inhaber.name}<br />
    {adresse.strasse}<br />
    {`${adresse.plz} ${adresse.ort}`}
  </p>

  <h2>Kontakt</h2>
  <p>
    Telefon: <a href={telefonLink}>{kontakt.telefon}</a><br />
    E-Mail: <a href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
  </p>

  <h2>Verbraucher&shy;streit&shy;beilegung/Universal&shy;schlichtungs&shy;stelle</h2>
  <p>Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.</p>

  <p>Quelle: <a href="https://www.e-recht24.de">eRecht24</a></p>
</Rechtliches>
