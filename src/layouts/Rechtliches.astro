---
/** Rahmen für Impressum, Datenschutz & Co.: schmale, gut lesbare Textspalte. */
import Base from './Base.astro';

interface Props {
  titel: string;
  beschreibung?: string;
  noindex?: boolean;
}
const { titel, beschreibung, noindex } = Astro.props;
---

<Base titel={titel} beschreibung={beschreibung} noindex={noindex}>
  <article class="container-page max-w-3xl py-14 sm:py-20">
    <h1 class="text-4xl font-bold sm:text-5xl">{titel}</h1>
    <div class="rechtstext mt-10">
      <slot />
    </div>
  </article>
</Base>

<style is:global>
  .rechtstext > * + * {
    margin-top: 1rem;
  }
  .rechtstext h2 {
    margin-top: 2.5rem;
    font-size: 1.5rem;
  }
  .rechtstext h3 {
    margin-top: 1.75rem;
    font-size: 1.2rem;
  }
  .rechtstext ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .rechtstext ul > li + li {
    margin-top: 0.35rem;
  }
  .rechtstext a {
    overflow-wrap: anywhere;
  }
</style>
