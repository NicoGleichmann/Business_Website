---
import Icon from './Icon.astro';
---

<button
  type="button"
  data-theme-toggle
  aria-pressed="false"
  aria-label="Dunkelmodus"
  title="Hell/Dunkel umschalten"
  class="text-muted hover:bg-soft hover:text-fg inline-flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full transition-colors"
>
  <Icon name="moon" size={20} class="icon-moon" />
  <Icon name="sun" size={20} class="icon-sun" />
</button>

<style is:global>
  .icon-sun {
    display: none;
  }
  :root[data-theme='dark'] .icon-sun {
    display: block;
  }
  :root[data-theme='dark'] .icon-moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .icon-sun {
      display: block;
    }
    :root:not([data-theme='light']) .icon-moon {
      display: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const systemDunkel = window.matchMedia('(prefers-color-scheme: dark)');
  const aktuell = () => root.getAttribute('data-theme') ?? (systemDunkel.matches ? 'dark' : 'light');

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((knopf) => {
    const sync = () => knopf.setAttribute('aria-pressed', String(aktuell() === 'dark'));
    sync();
    systemDunkel.addEventListener('change', sync);
    knopf.addEventListener('click', () => {
      const neu = aktuell() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', neu);
      try {
        localStorage.setItem('theme', neu);
      } catch {
        // Speichern nicht möglich (z. B. privater Modus) – Umschalten klappt trotzdem.
      }
      sync();
    });
  });
</script>
