---
/**
 * Kontaktformular.
 * - Mit PUBLIC_FORM_WEBHOOK_URL: sendet per POST an den n8n-Webhook.
 * - Ohne: öffnet das E-Mail-Programm mit vorbereiteter Nachricht (mailto-Fallback, nur per JavaScript –
 *   ein Formularziel „mailto:“ würde der Browser auf HTTPS-Seiten als unsicher markieren).
 * - Die Empfängeradresse steht zweigeteilt im HTML, damit Schutzfilter (z. B. Cloudflares
 *   E-Mail-Verschleierung) sie nicht umschreiben und das Empfängerfeld leer bleibt.
 * - Honeypot-Feld "website": Menschen sehen es nicht, Spam-Bots füllen es aus.
 */
import { istGesetzt, site, webhookUrl } from '../config/site';
import { kontakt } from '../content/texte';

const f = kontakt.formular;
const email = istGesetzt(site.kontakt.email) ? site.kontakt.email : '';
const modus = webhookUrl ? 'webhook' : 'mailto';
const [emailName = '', emailDomain = ''] = email.split('@');
---

<form
  method="post"
  action={modus === 'webhook' ? webhookUrl : undefined}
  aria-labelledby="formular-titel"
  class="card"
  data-kontaktformular
  data-modus={modus}
  data-email-name={emailName}
  data-email-domain={emailDomain}
  data-betreff={f.mailtoBetreff}
  data-sendet={f.sendet}
  data-erfolg={f.erfolg}
  data-fehler={f.fehler}
  data-mailto={f.mailto}
  data-email-fehlt={f.emailFehlt}
>
  <h3 id="formular-titel" class="text-xl">{f.titel}</h3>

  <div class="mt-6 space-y-5">
    <div>
      <label for="kf-name" class="block font-medium">{f.name}</label>
      <input
        id="kf-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        maxlength="120"
        class="feld"
        aria-describedby="kf-name-fehler"
        data-fehler-leer={f.fehlerName}
      />
      <p id="kf-name-fehler" class="feld-fehler" hidden></p>
    </div>

    <div>
      <label for="kf-email" class="block font-medium">{f.email}</label>
      <input
        id="kf-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        required
        maxlength="200"
        class="feld"
        aria-describedby="kf-email-fehler"
        data-fehler-leer={f.fehlerEmailLeer}
        data-fehler-format={f.fehlerEmailFormat}
      />
      <p id="kf-email-fehler" class="feld-fehler" hidden></p>
    </div>

    <div>
      <label for="kf-betrieb" class="block font-medium">
        {f.betrieb} <span class="text-muted font-normal">{f.optional}</span>
      </label>
      <input
        id="kf-betrieb"
        name="betrieb"
        type="text"
        autocomplete="organization"
        maxlength="160"
        class="feld"
        aria-describedby="kf-betrieb-hinweis"
      />
      <p id="kf-betrieb-hinweis" class="feld-hinweis">{f.betriebHinweis}</p>
    </div>

    <div>
      <label for="kf-zeit" class="block font-medium">
        {f.zeit} <span class="text-muted font-normal">{f.optional}</span>
      </label>
      <textarea id="kf-zeit" name="zeit" rows="4" maxlength="3000" class="feld resize-y" aria-describedby="kf-zeit-hinweis"
      ></textarea>
      <p id="kf-zeit-hinweis" class="feld-hinweis">{f.zeitHinweis}</p>
    </div>

    <!-- Honeypot: für Menschen unsichtbar. Bitte NICHT entfernen. -->
    <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
      <label for="kf-website">Website (bitte leer lassen)</label>
      <input id="kf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div>
      <div class="flex items-start gap-3">
        <input
          id="kf-datenschutz"
          name="datenschutz"
          type="checkbox"
          value="gelesen"
          required
          class="mt-1 size-5 shrink-0 cursor-pointer accent-[var(--accent)]"
          aria-describedby="kf-datenschutz-fehler"
          data-fehler-leer={f.fehlerDatenschutz}
        />
        <label for="kf-datenschutz" class="cursor-pointer">
          {f.datenschutzVor} <a href="/datenschutz/">{f.datenschutzLink}</a>{' '}{f.datenschutzNach}
        </label>
      </div>
      <p id="kf-datenschutz-fehler" class="feld-fehler" hidden></p>
    </div>
  </div>

  <div
    data-status
    role="status"
    aria-live="polite"
    tabindex="-1"
    hidden
    class="data-[art=erfolg]:border-accent data-[art=erfolg]:bg-accent-soft data-[art=fehler]:border-danger data-[art=info]:border-accent mt-6 rounded-xl border-2 p-4 font-medium"
  >
  </div>

  <button type="submit" data-nur-mit-js={modus === 'mailto' ? '' : undefined} class="btn btn-primary mt-6 w-full cursor-pointer sm:w-auto">
    {f.senden}
  </button>
  {
    modus === 'mailto' && email && (
      <noscript>
        <p class="mt-6">
          {f.ohneJs} <a href={`mailto:${email}`}>{email}</a>
        </p>
      </noscript>
    )
  }
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-kontaktformular]').forEach((form) => {
    // Eigene, deutschsprachige Fehlermeldungen statt der Browser-Blasen.
    form.noValidate = true;

    const d = form.dataset;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const knopf = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const knopfText = knopf.textContent ?? '';
    const pflichtFelder = Array.from(form.querySelectorAll<HTMLInputElement>('[required]'));

    const zeige = (text: string, art: 'erfolg' | 'fehler' | 'info') => {
      status.textContent = text;
      status.dataset.art = art;
      status.hidden = false;
      status.focus();
    };

    const pruefe = (feld: HTMLInputElement): boolean => {
      let meldung = '';
      if (feld.validity.valueMissing) meldung = feld.dataset.fehlerLeer ?? '';
      else if (feld.validity.typeMismatch) meldung = feld.dataset.fehlerFormat ?? '';
      feld.setAttribute('aria-invalid', meldung ? 'true' : 'false');
      const fehler = document.getElementById(`${feld.id}-fehler`);
      if (fehler) {
        fehler.textContent = meldung;
        fehler.hidden = !meldung;
      }
      return !meldung;
    };

    // Nach einem Fehler beim Tippen erneut prüfen, damit die Meldung verschwindet.
    pflichtFelder.forEach((feld) =>
      feld.addEventListener(feld.type === 'checkbox' ? 'change' : 'input', () => {
        if (feld.getAttribute('aria-invalid') === 'true') pruefe(feld);
      }),
    );

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.hidden = true;

      const ungueltig = pflichtFelder.filter((feld) => !pruefe(feld));
      if (ungueltig.length > 0) {
        ungueltig[0].focus();
        return;
      }

      const daten = new FormData(form);

      // Honeypot ausgefüllt → vermutlich ein Bot: so tun, als hätte es geklappt.
      if (String(daten.get('website') ?? '').trim() !== '') {
        form.reset();
        zeige(d.erfolg ?? '', 'erfolg');
        return;
      }

      if (d.modus === 'webhook') {
        const felder = new URLSearchParams();
        daten.forEach((wert, schluessel) => felder.append(schluessel, String(wert)));
        knopf.disabled = true;
        knopf.textContent = d.sendet ?? knopfText;
        try {
          const antwort = await fetch(form.action, {
            method: 'POST',
            body: felder,
            headers: { Accept: 'application/json' },
            redirect: 'manual',
          });
          if (!antwort.ok && antwort.type !== 'opaqueredirect') throw new Error(`HTTP ${antwort.status}`);
          form.reset();
          zeige(d.erfolg ?? '', 'erfolg');
        } catch {
          zeige(d.fehler ?? '', 'fehler');
        } finally {
          knopf.disabled = false;
          knopf.textContent = knopfText;
        }
        return;
      }

      // mailto-Fallback: E-Mail-Programm mit vorbereiteter Nachricht öffnen.
      const empfaenger = d.emailName && d.emailDomain ? `${d.emailName}@${d.emailDomain}` : '';
      if (!empfaenger) {
        zeige(d.emailFehlt ?? '', 'fehler');
        return;
      }
      const text = [
        `Name: ${daten.get('name')}`,
        `E-Mail: ${daten.get('email')}`,
        `Betrieb: ${daten.get('betrieb') || '–'}`,
        '',
        'Was kostet mich am meisten Zeit?',
        String(daten.get('zeit') || '–'),
      ].join('\r\n');
      window.location.href = `mailto:${empfaenger}?subject=${encodeURIComponent(d.betreff ?? '')}&body=${encodeURIComponent(text)}`;
      zeige(d.mailto ?? '', 'info');
    });
  });
</script>
