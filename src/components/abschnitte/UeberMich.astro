---
import { Image } from 'astro:assets';
import { site } from '../../config/site';
import { ueberMich } from '../../content/texte';
import foto from '../../assets/nico-gleichmann.jpg';
import Icon from '../Icon.astro';
import Txt from '../Txt.astro';

/**
 * Foto austauschen: neue Datei unter demselben Namen nach src/assets/nico-gleichmann.jpg legen
 * (quadratisch, am besten mind. 800 × 800 px). Astro verkleinert und komprimiert sie beim Build.
 */
---

<section id="ueber-mich" aria-labelledby="ueber-mich-titel" class="section">
  <div class="container-page grid grid-cols-1 items-start gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-14">
    <Image
      src={foto}
      alt={`Porträt von ${site.inhaber.name}`}
      width={300}
      height={300}
      class="border-border aspect-square w-full max-w-[300px] rounded-2xl border object-cover"
    />
    <div>
      <p class="eyebrow">{ueberMich.eyebrow}</p>
      <h2 id="ueber-mich-titel" class="h2"><Txt text={ueberMich.titel} /></h2>
      <div class="mt-6 max-w-2xl space-y-4 text-lg">
        {
          ueberMich.absaetze.map((absatz) => (
            <p>
              <Txt text={absatz} />
            </p>
          ))
        }
      </div>
      <h3 class="mt-10 text-xl"><Txt text={ueberMich.werteTitel} /></h3>
      <ul class="mt-4 max-w-2xl space-y-3">
        {
          ueberMich.werte.map((wert) => (
            <li class="flex gap-3">
              <Icon name="check" size={22} class="text-accent mt-0.5 shrink-0" />
              <span>
                <Txt text={wert} />
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
