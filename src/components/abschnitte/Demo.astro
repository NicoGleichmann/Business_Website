---
import { demo } from '../../content/texte';
import TodoBox from '../TodoBox.astro';
import Txt from '../Txt.astro';
---

<section id="demo" aria-labelledby="demo-titel" class="section bg-band border-border border-y">
  <div class="container-page">
    <p class="eyebrow">{demo.eyebrow}</p>
    <h2 id="demo-titel" class="h2"><Txt text={demo.titel} /></h2>
    <p class="lead"><Txt text={demo.text} /></p>

    <div class="mt-10 max-w-4xl">
      {
        demo.video ? (
          <video
            class="border-border aspect-video w-full rounded-2xl border bg-black"
            controls
            preload="none"
            playsinline
            poster={demo.poster || undefined}
          >
            <source src={demo.video} type="video/mp4" />
            {demo.untertitel && <track kind="captions" src={demo.untertitel} srclang="de" label="Deutsch" default />}
            Ihr Browser kann dieses Video nicht abspielen. <a href={demo.video}>Video herunterladen</a>.
          </video>
        ) : (
          <TodoBox text={demo.platzhalter} icon="play" class="aspect-video" />
        )
      }
    </div>
  </div>
</section>
