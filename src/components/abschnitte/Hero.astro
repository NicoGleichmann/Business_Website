---
import { istGesetzt, site, webhookUrl } from '../../config/site';
import { demo, hero, pause, preise } from '../../content/texte';
import DemoVideo from '../DemoVideo.astro';
import Icon from '../Icon.astro';
import RueckrufFormular from '../RueckrufFormular.astro';
import Txt from '../Txt.astro';

const beispiel = [
  { icon: 'mail', text: 'Neue Anfrage per E-Mail' },
  { icon: 'bot', text: 'Assistent beantwortet die Standardfragen' },
  { icon: 'calendarCheck', text: 'Termin steht im Kalender' },
] as const;

const telefon = !site.pause && istGesetzt(site.kontakt.telefon) ? `tel:${site.kontakt.telefon.replace(/[^\d+]/g, '')}` : '';
---

<section aria-labelledby="hero-titel" class="relative overflow-hidden">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 -right-40 size-[36rem] rounded-full bg-[radial-gradient(closest-side,var(--accent-soft),transparent)] opacity-70 blur-3xl"
  >
  </div>

  <div class="container-page relative grid grid-cols-1 items-center gap-14 pt-14 pb-16 sm:pt-20 sm:pb-24 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]">
    <div>
      {
        !site.pause && preise.anzeigen && preise.einfuehrung.freiePlaetze > 0 && (
          <a
            href="#preise"
            class="border-accent bg-accent-soft text-fg hover:text-fg mb-7 inline-flex min-h-11 max-w-full items-center gap-2.5 rounded-full border py-1.5 pr-4 pl-4 text-[0.95rem] font-medium no-underline sm:pl-1.5"
          >
            <span class="bg-accent size-2 shrink-0 rounded-full sm:hidden" aria-hidden="true"></span>
            <span class="bg-accent text-on-accent hidden shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold tracking-wide uppercase sm:inline-block">
              {preise.einfuehrung.label}
            </span>
            <span>{preise.einfuehrung.heroText}</span>
            <Icon name="arrowRight" size={16} class="text-accent shrink-0" />
          </a>
        )
      }
      <p class="eyebrow"><Txt text={hero.eyebrow} /></p>
      <h1 id="hero-titel" class="mt-4 text-[2.15rem] font-bold sm:text-5xl lg:text-[3.4rem]">
        <Txt text={hero.titel} />
      </h1>
      <p class="text-muted mt-6 max-w-2xl text-lg sm:text-xl"><Txt text={hero.text} /></p>

      {
        webhookUrl ? (
          <>
            {/* Mit n8n-Webhook: Das Kurzformular ist die Live-Demo der Anfrage-Automatik. */}
            <RueckrufFormular />
            <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-[0.95rem]">
              <a href="#termin">{hero.formular.termin}</a>
              <a href="#ablauf">{hero.sekundaer}</a>
            </p>
          </>
        ) : (
          <>
            {site.pause && (
              <div class="border-accent bg-accent-soft mt-9 rounded-2xl border p-5 sm:p-6">
                <p class="font-semibold">{pause.titel}</p>
                <p class="mt-1.5">
                  <Txt text={pause.text} />
                </p>
              </div>
            )}
            <div class:list={['flex flex-col gap-3 sm:flex-row sm:items-center', site.pause ? 'mt-6' : 'mt-9']}>
              <a href="#kontakt" class="btn btn-primary text-[1.05rem]">
                {site.pause ? pause.cta : hero.cta}
                <Icon name="arrowRight" size={20} />
              </a>
              {/* Handy: „Anrufen“ und „So läuft es ab“ nebeneinander; ab Tablet nur „So läuft es ab“ */}
              <div class="grid grid-cols-2 gap-3 sm:contents">
                {telefon && (
                  <a href={telefon} class="btn btn-secondary px-4 sm:hidden">
                    <Icon name="phone" size={18} />
                    {hero.anrufen}
                  </a>
                )}
                <a href="#ablauf" class:list={['btn btn-secondary px-4 sm:px-6', !telefon && 'col-span-2']}>
                  {hero.sekundaer}
                </a>
              </div>
            </div>
            {!site.pause && (
              <p class="text-muted mt-4 text-[0.95rem]">
                <Txt text={hero.ctaHinweis} />
              </p>
            )}
          </>
        )
      }

      {demo.video && <DemoVideo class="mt-10 lg:hidden" />}

      <div class="border-border mt-10 border-t pt-6">
        <p class="text-muted text-sm font-medium" id="branchen-titel">{hero.branchenTitel}</p>
        <ul class="mt-3 flex flex-wrap gap-2" aria-labelledby="branchen-titel">
          {
            hero.branchen.map((branche) => (
              <li class="border-border bg-card rounded-full border px-3.5 py-1.5 text-[0.95rem]">{branche}</li>
            ))
          }
        </ul>
      </div>
    </div>

    {demo.video ? (
      <DemoVideo class="hidden lg:block" />
    ) : (
    <figure class="hidden lg:block">
      <ol class="border-border bg-card relative space-y-3 rounded-3xl border p-6 shadow-[0_24px_60px_-30px_rgb(15_110_106/0.35)]">
        {
          beispiel.map((schritt, i) => (
            <li class="bg-card-muted border-border flex items-center gap-4 rounded-2xl border p-4">
              <span class="bg-accent-soft text-accent inline-flex size-11 shrink-0 items-center justify-center rounded-xl">
                <Icon name={schritt.icon} size={22} />
              </span>
              <span class="font-medium">{schritt.text}</span>
              {i === beispiel.length - 1 && <Icon name="check" size={20} class="text-accent ml-auto" />}
            </li>
          ))
        }
      </ol>
      <figcaption class="text-muted mt-3 text-center text-sm">Beispiel: So kann ein automatischer Ablauf aussehen.</figcaption>
    </figure>
    )}
  </div>
</section>
