---
/**
 * Preise: Gründerpreis-Hinweis, zwei Bereiche mit Paketen (Online-Präsenz, Automatisierung & KI),
 * hervorgehobener Kasten „Ihre eigene Lösung“, eine Betreuung für alle Pakete, Kleingedrucktes.
 * Texte und Preise: src/content/texte.ts bei `preise`.
 */
import { preise } from '../../content/texte';
import Icon from '../Icon.astro';
import Txt from '../Txt.astro';

const e = preise.einfuehrung;
const b = preise.betreuung;
const eigen = preise.eigeneLoesung;
const [bereichOnline, bereichAssistenten] = preise.bereiche;
const titelBereich = (bereich: (typeof preise.bereiche)[number]) =>
  preise.ki.anzeigen ? bereich.titel : bereich.titelOhneKi;
---

<section id="preise" aria-labelledby="preise-titel" class="section">
  <div class="container-page">
    <p class="eyebrow">{preise.eyebrow}</p>
    <h2 id="preise-titel" class="h2"><Txt text={preise.titel} /></h2>
    <p class="lead"><Txt text={preise.text} /></p>

    {
      e.freiePlaetze > 0 && (
        <div class="border-accent bg-accent-soft mt-10 flex flex-col gap-4 rounded-2xl border p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
          <div>
            <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-semibold">
              <span class="bg-accent text-on-accent rounded-full px-2.5 py-0.5 text-xs tracking-wide uppercase">
                {e.label}
              </span>
              {e.frei.replace('{frei}', String(e.freiePlaetze)).replace('{plaetze}', String(e.plaetze))}
            </p>
            <p class="mt-1.5">
              <Txt text={e.text} />
            </p>
          </div>
          <a href="#kontakt" class="btn btn-primary shrink-0">
            {e.cta}
            <Icon name="arrowRight" size={18} />
          </a>
        </div>
      )
    }

    {/* Online-Präsenz (1 Paket) und Assistenten (2 Pakete) – ab Desktop drei Karten in einer Reihe.
        Jeder Bereich belegt drei Zeilen (Titel, Text, Karten), damit die Karten oben auf einer Linie beginnen. */}
    <div class="mt-8 grid grid-cols-1 gap-5 lg:grid-cols-3 lg:gap-y-0">
      {
        [bereichOnline, bereichAssistenten].map((bereich, i) => (
          <div class:list={['flex flex-col lg:row-span-3 lg:grid lg:grid-rows-subgrid', i === 1 && 'lg:col-span-2']}>
            <h3 class="text-accent text-sm font-semibold tracking-wide uppercase">{titelBereich(bereich)}</h3>
            <p class="text-muted mt-1 text-[0.95rem]">
              <Txt text={bereich.text} />
            </p>
            <ul class:list={['mt-3 grid flex-1 grid-cols-1 gap-5', i === 1 && 'sm:grid-cols-2']}>
              {bereich.pakete.map((paket) => (
                <li class="card flex flex-col">
                  <p class="text-muted text-sm">{paket.art}</p>
                  <h4 class="mt-1 text-xl font-semibold">
                    <Txt text={paket.titel} />
                  </h4>
                  <ul class="mt-4 flex-1 space-y-2.5 text-[0.95rem]">
                    {paket.enthalten.map((punkt) => (
                      <li class="flex gap-2.5">
                        <Icon name="check" size={20} class="text-accent mt-0.5 shrink-0" />
                        <span>
                          <Txt text={punkt} />
                        </span>
                      </li>
                    ))}
                  </ul>
                  {preise.ki.anzeigen && paket.ki && (
                    <p class="bg-accent-soft mt-4 flex gap-2.5 rounded-xl p-3 text-[0.95rem]">
                      <Icon name="bot" size={20} class="text-accent mt-0.5 shrink-0" />
                      <span>
                        <strong class="font-semibold">{preise.ki.label}:</strong> <Txt text={paket.ki} />
                      </span>
                    </p>
                  )}
                  <dl class="border-border mt-5 border-t pt-4 tabular-nums">
                    <dt class="text-muted text-sm">{preise.einmaligLabel}</dt>
                    <dd class="mt-0.5 text-2xl font-semibold">
                      <Txt text={paket.einmalig} />
                    </dd>
                    {paket.einmaligHinweis && (
                      <dd class="text-muted text-sm">
                        <Txt text={paket.einmaligHinweis} />
                      </dd>
                    )}
                    <dd class="text-muted mt-2 text-sm">
                      dazu Betreuung: {b.preis} {b.einheit}
                    </dd>
                  </dl>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {/* Ihre eigene Lösung: bewusst hervorgehoben, Kunden sollen eigene Ideen mitbringen */}
    <div
      class="border-accent bg-accent-soft mt-8 grid grid-cols-1 gap-6 rounded-2xl border-2 p-6 sm:p-7 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-10"
    >
      <div>
        <p class="text-accent text-sm font-semibold tracking-wide uppercase">{eigen.eyebrow}</p>
        <h3 class="mt-2 text-2xl"><Txt text={eigen.titel} /></h3>
        <p class="mt-3"><Txt text={eigen.text} /></p>
        <ol class="mt-5 space-y-3">
          {
            eigen.schritte.map((schritt, i) => (
              <li class="flex gap-3">
                <span
                  class="bg-accent text-on-accent flex size-7 shrink-0 items-center justify-center rounded-full text-sm font-semibold"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <span class="pt-0.5">
                  <strong class="font-semibold">{schritt.titel}</strong> <Txt text={schritt.text} />
                </span>
              </li>
            ))
          }
        </ol>
        <a href="#kontakt" class="btn btn-primary mt-6">
          {eigen.cta}
          <Icon name="arrowRight" size={18} />
        </a>
      </div>
      <div class="bg-card border-border rounded-xl border p-5">
        <p class="font-semibold">{eigen.beispieleTitel}</p>
        <ul class="mt-3 space-y-2.5 text-[0.95rem]">
          {
            eigen.beispiele.map((beispiel) => (
              <li class="flex gap-2.5">
                <Icon name="check" size={20} class="text-accent mt-0.5 shrink-0" />
                <span>
                  <Txt text={beispiel} />
                </span>
              </li>
            ))
          }
        </ul>
        <p class="border-border mt-5 border-t pt-4 tabular-nums">
          <span class="text-2xl font-semibold"><Txt text={eigen.preis} /></span>
          <span class="text-muted block text-sm"><Txt text={eigen.preisHinweis} /></span>
        </p>
      </div>
    </div>

    {/* Eine Betreuung für alle Pakete */}
    <div class="card mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-10">
      <div>
        <h3 class="text-xl"><Txt text={b.titel} /></h3>
        <p class="text-accent mt-2 text-4xl font-semibold tabular-nums">{b.preis}</p>
        <p class="text-muted">{b.einheit}</p>
        <p class="mt-3"><Txt text={b.kernsatz} /></p>
      </div>
      <ul class="grid grid-cols-1 content-start gap-2.5 sm:grid-cols-2">
        {
          b.punkte.map((punkt) => (
            <li class="flex gap-2.5">
              <Icon name="check" size={20} class="text-accent mt-0.5 shrink-0" />
              <span>
                <Txt text={punkt} />
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <ul class="text-muted mt-5 max-w-4xl list-disc space-y-1 pl-5 text-sm">
      {
        preise.fussnoten.map((notiz) => (
          <li>
            <Txt text={notiz} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
