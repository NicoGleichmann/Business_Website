---
import { preise } from '../../content/texte';
import Icon from '../Icon.astro';
import Txt from '../Txt.astro';

const e = preise.einfuehrung;
const o = preise.ohneWebsite;
---

<section id="preise" aria-labelledby="preise-titel" class="section">
  <div class="container-page">
    <p class="eyebrow">{preise.eyebrow}</p>
    <h2 id="preise-titel" class="h2"><Txt text={preise.titel} /></h2>
    <p class="lead"><Txt text={preise.text} /></p>

    {
      e.freiePlaetze > 0 && (
        <div class="border-accent bg-accent-soft mt-10 flex flex-col gap-4 rounded-2xl border p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
          <div>
            <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-semibold">
              <span class="bg-accent text-on-accent rounded-full px-2.5 py-0.5 text-xs tracking-wide uppercase">
                {e.label}
              </span>
              {e.frei.replace('{frei}', String(e.freiePlaetze)).replace('{plaetze}', String(e.plaetze))}
            </p>
            <p class="mt-1.5">
              <Txt text={e.text} />
            </p>
          </div>
          <a href="#kontakt" class="btn btn-primary shrink-0">
            {e.cta}
            <Icon name="arrowRight" size={18} />
          </a>
        </div>
      )
    }

    <ul class:list={['mt-8 grid grid-cols-1 gap-5', preise.pakete.length === 2 ? 'lg:grid-cols-2' : 'lg:grid-cols-3']}>
      {
        preise.pakete.map((paket) => (
          <li class="card flex flex-col lg:row-span-5 lg:grid lg:grid-rows-subgrid lg:gap-y-0">
            <h3 class="text-xl">
              <Txt text={paket.titel} />
            </h3>
            <p class="text-muted mt-2">
              <Txt text={paket.text} />
            </p>

            <p class="text-muted mt-6 text-sm font-semibold tracking-wide uppercase">{preise.enthaltenLabel}</p>
            <ul class="mt-3 flex-1 space-y-2.5 text-[0.95rem]">
              {paket.enthalten.map((punkt) => (
                <li class="flex gap-2.5">
                  <Icon name="check" size={20} class="text-accent mt-0.5 shrink-0" />
                  <span>
                    <Txt text={punkt} />
                  </span>
                </li>
              ))}
            </ul>

            <dl class="border-border mt-6 space-y-4 border-t pt-5 tabular-nums">
              <div>
                <dt class="text-muted text-sm">{preise.einmaligLabel}</dt>
                <dd class="mt-0.5 text-2xl font-semibold">
                  <Txt text={paket.einmalig} />
                </dd>
                {paket.einmaligHinweis && (
                  <dd class="text-muted text-sm">
                    <Txt text={paket.einmaligHinweis} />
                  </dd>
                )}
              </div>
              <div>
                <dt class="text-muted text-sm">{preise.monatlichLabel}</dt>
                <dd class="mt-0.5 text-lg font-semibold">
                  <Txt text={paket.monatlich} />
                </dd>
                {paket.monatlichHinweis.map((hinweis) => (
                  <dd class="text-muted text-sm">
                    <Txt text={hinweis} />
                  </dd>
                ))}
              </div>
            </dl>
          </li>
        ))
      }
    </ul>

    <div class="card mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-10">
      <div>
        <h3 class="text-xl"><Txt text={o.titel} /></h3>
        <p class="text-muted mt-2"><Txt text={o.text} /></p>
      </div>
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          o.pakete.map((paket) => (
            <li class="bg-card-muted border-border rounded-xl border p-4 sm:p-5">
              <p class="font-semibold">
                <Txt text={paket.titel} />
              </p>
              <dl class="mt-3 space-y-2 text-[0.95rem] tabular-nums">
                <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                  <dt class="text-muted">{preise.einmaligLabel}</dt>
                  <dd class="text-lg font-semibold">
                    <Txt text={paket.einmalig} />
                  </dd>
                  {paket.einmaligHinweis && (
                    <dd class="text-muted w-full text-sm">
                      <Txt text={paket.einmaligHinweis} />
                    </dd>
                  )}
                </div>
                <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                  <dt class="text-muted">{preise.monatlichLabel}</dt>
                  <dd class="font-semibold">
                    <Txt text={paket.monatlich} />
                  </dd>
                </div>
              </dl>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="bg-accent-soft mt-6 rounded-2xl p-6 sm:p-7">
      <h3 class="text-xl"><Txt text={preise.wartung.titel} /></h3>
      <p class="mt-2 max-w-3xl"><Txt text={preise.wartung.text} /></p>
      <ul class="mt-4 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          preise.wartung.punkte.map((punkt) => (
            <li class="flex gap-2.5">
              <Icon name="check" size={20} class="text-accent mt-0.5 shrink-0" />
              <span>
                <Txt text={punkt} />
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="text-muted mt-5 max-w-4xl text-sm"><Txt text={preise.fussnote} /></p>
  </div>
</section>
