---
import { site } from '../config/site';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { pause, preise } from '../content/texte';

/** Auf dem Handy steht der Name zweizeilig, damit Kopfzeile und Button nebeneinander passen. */
const [vorname, ...rest] = site.name.split(' ');
const nachname = rest.join(' ');

const navigation = [
  { href: '/#leistungen', text: 'Leistungen' },
  { href: '/#ablauf', text: 'Ablauf' },
  ...(preise.anzeigen ? [{ href: '/#preise', text: 'Preise' }] : []),
  { href: '/#ueber-mich', text: 'Über mich' },
  { href: '/#faq', text: 'Fragen' },
];
---

<header class="border-border bg-bg/90 sticky top-0 z-40 border-b backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-3">
    <a href="/" class="text-fg hover:text-fg flex items-center gap-2.5 no-underline">
      <Logo size={30} />
      <span class="flex flex-col leading-tight">
        <span class="text-[0.95rem] font-semibold tracking-tight sm:text-lg">
          <span class="block sm:inline">{vorname}</span>{' '}<span class="block sm:inline">{nachname}</span>
        </span>
        <span class="text-muted hidden text-xs sm:block lg:hidden xl:block">{site.taetigkeit}</span>
      </span>
    </a>

    <nav aria-label="Hauptnavigation" class="hidden lg:block">
      <ul class="flex items-center gap-8 text-[0.95rem]">
        {
          navigation.map((punkt) => (
            <li>
              <a href={punkt.href} class="text-muted hover:text-fg no-underline">
                {punkt.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1.5 sm:gap-3">
      <ThemeToggle />
      <a href="/#kontakt" class="btn btn-primary min-h-11 px-4 text-[0.95rem] sm:px-5">
        {
          site.pause ? (
            pause.header
          ) : (
            <>
              <span class="sm:hidden">Erstgespräch</span>
              <span class="hidden sm:inline">Kostenloses Erstgespräch</span>
            </>
          )
        }
      </a>
    </div>
  </div>
</header>
